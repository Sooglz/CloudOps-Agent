# ============================================================
# 环境变量配置模板
# 使用方法：
#   1. 把本文件复制一份，重命名为 .env
#   2. 填入你自己的 API Key
#   3. 不要把 .env 提交到 Git（它已在 .gitignore 里）
# ============================================================

# DeepSeek API Key（在 https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=在这里填你的key

# DeepSeek 的 OpenAI 兼容接口地址（一般不用改）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 使用的模型名（deepseek-chat 是通用对话模型，性价比高）
DEEPSEEK_MODEL=deepseek-chat

# ============================================================
# 智谱 Embedding 配置（用于 RAG 向量检索）
# 在 https://open.bigmodel.cn 注册获取 Key
# ============================================================

# 智谱 API Key
ZHIPU_API_KEY=在这里填你的智谱key

# 智谱 OpenAI 兼容接口地址（一般不用改）
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 智谱 Embedding 模型名（embedding-2 维度 1024）
ZHIPU_EMBEDDING_MODEL=embedding-2
