# ============================================================
# Docker 构建时忽略的文件（不复制进镜像）
# 作用：减小镜像体积、避免把密钥和本地缓存打进镜像
# ============================================================

# 虚拟环境（容器内会重新装依赖，不需要本地 .venv）
.venv/

# 敏感文件（真实 Key 绝不能进镜像）
.env

# 向量库缓存（容器启动时会重建）
chroma_db/

# Git 相关
.git/
.gitignore

# Python 缓存
__pycache__/
*.pyc
*.pyo

# 文档（可选择性忽略，构建镜像不需要）
docs/
*.md

# 调试临时文件
_*.txt
